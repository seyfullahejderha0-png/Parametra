rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Yardımcı fonksiyon: kullanıcının çalışma alanına erişim yetkisi var mı?
    function isAllowedUser(userId) {
      return request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(userId)/meta/sharing) &&
         request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/meta/sharing).data.allowedUids)
      );
    }

    // Kullanıcı dokümanları
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Ortak alanlar için özel yetkilendirme (üyelerin ve davet kodu olanların erişebilmesi için)
      match /shared_spaces/{spaceId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || 
          request.auth.uid in resource.data.memberUids ||
          // Davet kodu geçerli ise okumaya izin ver (katılacak üyenin ilk okumayı yapabilmesi için)
          (resource != null && resource.data.inviteCode != null &&
           exists(/databases/$(database)/documents/invite_codes/$(resource.data.inviteCode)) &&
           get(/databases/$(database)/documents/invite_codes/$(resource.data.inviteCode)).data.spaceId == spaceId)
        );
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          // Davet kodu doğrulaması ile katılım (User B yazabilir)
          (request.resource.data.inviteCode != null &&
           exists(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode)) &&
           get(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode)).data.spaceId == spaceId &&
           get(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode)).data.ownerId == userId) ||
          // Zaten üye ise güncelleyebilir
          (resource != null && request.auth.uid in resource.data.memberUids)
        );
      }

      // Paylaşım meta dökümanı
      match /meta/sharing {
        allow read: if request.auth != null && (
          request.auth.uid == userId || 
          (resource != null && request.auth.uid in resource.data.allowedUids)
        );
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          // Davet kodu ile katılan kullanıcı kendisini allowedUids listesine ekleyebilir
          (request.resource.data.inviteCode != null &&
           exists(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode)) &&
           get(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode)).data.ownerId == userId &&
           (resource == null || request.resource.data.allowedUids.hasAll(resource.data.allowedUids)) &&
           request.auth.uid in request.resource.data.allowedUids)
        );
      }
      
      // Yönetici Paneli için okuma izni verilen alt koleksiyonlar
      match /subscription/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /ai_usage/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Alt koleksiyonlar (finans, borçlar, hedefler, sağlık, ilaçlar, notlar vb.)
      match /{collection}/{docId} {
        allow read, write: if isAllowedUser(userId);
        
        match /{subCollection}/{subDocId} {
          allow read, write: if isAllowedUser(userId);
          
          match /{deepCollection}/{deepDocId} {
            allow read, write: if isAllowedUser(userId);
          }
        }
      }
    }
    
    // Ortak alan davet kodları
    match /invite_codes/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Genel Uygulama Ayarları (App Store / Play Store Linkleri)
    match /settings/{docId} {
      allow read: if true;
      allow write: if false; // Sadece Firebase Console üzerinden yönetilsin
    }
  }
}
